[
 {
  "id": "STRICT_VIM_DT",
  "source": "Pre-registered composite: dasha lords link AND double transit",
  "polarity": 1,
  "areas": [
   "career",
   "status",
   "marriage",
   "children",
   "foreign"
  ],
  "text": "MD and AD lords link to area houses AND Jupiter and Saturn both touch an area house",
  "steps": [
   {
    "as": "hs",
    "op": "area_houses"
   },
   {
    "as": "md",
    "op": "vim_lords",
    "args": {
     "level": 1
    }
   },
   {
    "as": "adl",
    "op": "vim_lords",
    "args": {
     "level": 2
    }
   },
   {
    "as": "a",
    "op": "lords_link",
    "args": {
     "planets": "$md",
     "houses": "$hs"
    }
   },
   {
    "as": "b",
    "op": "lords_link",
    "args": {
     "planets": "$adl",
     "houses": "$hs"
    }
   },
   {
    "as": "vl",
    "op": "both",
    "args": {
     "a": "$a",
     "b": "$b"
    }
   },
   {
    "as": "j",
    "op": "transit_touches",
    "args": {
     "planet": "Jupiter",
     "houses": "$hs"
    }
   },
   {
    "as": "s",
    "op": "transit_touches",
    "args": {
     "planet": "Saturn",
     "houses": "$hs"
    }
   },
   {
    "as": "dt",
    "op": "both",
    "args": {
     "a": "$j",
     "b": "$s"
    }
   },
   {
    "as": "hit",
    "op": "both",
    "args": {
     "a": "$vl",
     "b": "$dt"
    }
   }
  ],
  "fire": [
   {
    "ref": "hit"
   }
  ]
 },
 {
  "id": "STRICT_BCP_JUP",
