   },
   {
    "as": "j",
    "op": "transit_touches",
    "args": {
     "planet": "Jupiter",
     "houses": "$hs"
    }
   },
   {
    "as": "hit",
    "op": "both",
    "args": {
     "a": "$b",
     "b": "$j"
    }
   }
  ],
  "fire": [
   {
    "ref": "hit"
   }
  ]
 },
